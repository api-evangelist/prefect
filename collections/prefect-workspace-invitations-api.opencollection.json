{
  "opencollection": "1.0.0",
  "info": {
    "name": "Prefect Cloud Account Billing Workspace Invitations API",
    "version": "0.8.4"
  },
  "items": [
    {
      "info": {
        "name": "Workspace Invitations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Workspace Invitation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/accounts/:account_id/workspaces/:workspace_id/invitations/",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Invite a user to a workspace.\nAny PENDING invitations for the same user to the workspace will be revoked.\n\nRequired account permissions: `create:workspace_invitation`"
        },
        {
          "info": {
            "name": "Read Workspace Invitation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/:account_id/workspaces/:workspace_id/invitations/:id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an invitation by id\n\nRequired account permissions: `read:workspace_invitation`"
        },
        {
          "info": {
            "name": "Read Workspace Invitations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/accounts/:account_id/workspaces/:workspace_id/invitations/filter",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Query for invitations\n\nRequired account permissions: `read:workspace_invitation`"
        },
        {
          "info": {
            "name": "Revoke Workspace Invitation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/accounts/:account_id/workspaces/:workspace_id/invitations/:id/revoke",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an invitation by id\n\nRequired account permissions: `update:workspace_invitation`"
        }
      ]
    }
  ],
  "bundled": true
}