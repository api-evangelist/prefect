        {
          "info": {
            "name": "Get Task Run Artifacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/:account_id/workspaces/:workspace_id/task_runs/:id/artifacts",
            "headers": [
              {
                "name": "x-prefect-api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The task run id"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "depth",
                "value": "",
                "type": "query",
                "description": "Optional depth limit for recursion (0 = task run only)"
              },
              {
                "name": "since",
                "value": "",
                "type": "query",
                "description": "Only return artifacts created on or after this timestamp"
              },
              {
                "name": "until",
                "value": "",
                "type": "query",
                "description": "Only return artifacts created on or before this timestamp"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort order by creation time (asc or desc)"
              }
            ]
          },
          "docs": "Get all artifacts created within a task run, including artifacts from\nsubflow runs spawned by this task (recursively).\n\nRequired workspace scopes: `see_flows`"
        },
        {
          "info": {
            "name": "Get Task Run Materializations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/:account_id/workspaces/:workspace_id/task_runs/:id/assets/materializations",
            "headers": [
              {
                "name": "x-prefect-api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The task run id"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "depth",
                "value": "",
                "type": "query",
                "description": "Optional depth limit based on execution hierarchy. depth=0: only the task run. depth=1: task run + its descendants. None: unlimited depth (default)."
              },
              {
                "name": "since",
                "value": "",
                "type": "query",
                "description": "Only return materializations on or after this timestamp"
              },
              {
                "name": "until",
                "value": "",
                "type": "query",
                "description": "Only return materializations on or before this timestamp"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort order by occurred time (asc or desc)"
              }
            ]
          },
          "docs": "Get all asset materializations from a task run, including materializations\nfrom descendant runs.\n\nReturns a historical snapshot of materializations as they occurred, with asset\nproperties captured at materialization time (not current state).\n\nRequired workspace scopes: `see_assets`"
        },
