          "info": {
            "name": "Read Flow Run Resource Metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/:account_id/workspaces/:workspace_id/metrics/flow-runs/:flow_run_id",
            "headers": [
              {
                "name": "x-prefect-api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "flow_run_id",
                "value": "",
                "type": "path",
                "description": "The flow run ID"
              },
              {
                "name": "metric_names",
                "value": "",
                "type": "query",
                "description": "Filter to specific metric names"
              },
              {
                "name": "start_time",
                "value": "",
                "type": "query",
                "description": "Start of time range filter"
              },
              {
                "name": "end_time",
                "value": "",
                "type": "query",
                "description": "End of time range filter"
              }
            ]
          },
          "docs": "Get resource metrics (CPU, memory, etc.) for a specific flow run.\n\nRequired workspace scopes: `see_flows`"
        },
