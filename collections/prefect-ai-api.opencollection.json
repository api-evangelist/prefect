{
  "opencollection": "1.0.0",
  "info": {
    "name": "Prefect Cloud Account Billing AI API",
    "version": "0.8.4"
  },
  "items": [
    {
      "info": {
        "name": "AI",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Summarize Flow Run Logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/:account_id/workspaces/:workspace_id/logs/ai/flow_run_logs/:flow_run_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "flow_run_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Summarize error logs for a flow run.\n\nIf the `flow_run_id` is not found, or if there are no error logs for the\nflow run, the `result` will be `None`.\n\nRequired workspace scopes: `see_flows`"
        }
      ]
    }
  ],
  "bundled": true
}