{
  "opencollection": "1.0.0",
  "info": {
    "name": "Prefect Cloud Account Billing Block schemas API",
    "version": "0.8.4"
  },
  "items": [
    {
      "info": {
        "name": "Block schemas",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Block Schema",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/accounts/:account_id/workspaces/:workspace_id/block_schemas/",
            "headers": [
              {
                "name": "x-prefect-api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "\n\nRequired workspace scopes: `manage_blocks`"
        },
        {
          "info": {
            "name": "Read Block Schema By Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/:account_id/workspaces/:workspace_id/block_schemas/:id",
            "headers": [
              {
                "name": "x-prefect-api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The block schema id"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a block schema by id.\n\nRequired workspace scopes: `see_blocks`"
        },
        {
          "info": {
            "name": "Delete Block Schema",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/accounts/:account_id/workspaces/:workspace_id/block_schemas/:id",
            "headers": [
              {
                "name": "x-prefect-api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The block schema id"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a block schema by id.\n\nRequired workspace scopes: `manage_blocks`"
        },
        {
          "info": {
            "name": "Read Block Schemas",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/accounts/:account_id/workspaces/:workspace_id/block_schemas/filter",
            "headers": [
              {
                "name": "x-prefect-api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Read all block schemas, optionally filtered by type\n\nRequired workspace scopes: `see_blocks`"
        },
        {
          "info": {
            "name": "Read Block Schema By Checksum",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/:account_id/workspaces/:workspace_id/block_schemas/checksum/:checksum",
            "headers": [
              {
                "name": "x-prefect-api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "checksum",
                "value": "",
                "type": "path",
                "description": "The block schema checksum"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "query",
                "description": "Version of block schema. If not provided the most recently created block schema with the matching checksum will be returned."
              }
            ]
          },
          "docs": "\n\nRequired workspace scopes: `see_blocks`"
        }
      ]
    }
  ],
  "bundled": true
}